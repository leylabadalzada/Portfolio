@model PortfolioVM

<section class="portfolio section py-5" id="portfolio">
    <div class="container-fluid px-md-5">

        <!-- Səhifə Başlığı -->
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="fw-bold text-dark mb-1">All Projects</h2>
                <div class="bg-success rounded" style="width: 50px; height: 3px;"></div>
            </div>
        </div>

        <!-- 4 Sütunlu Grid -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model.Projects)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden bg-white project-card">

                        <!-- Kiçildilmiş və Çərçivəyə salınmış Şəkil Sahəsi -->
                        <div class="position-relative bg-light border-bottom" style="height: 150px; overflow: hidden;">
                            <img src="~/assets/images/projects/@item.Image"
                                 class="w-100 h-100"
                                 alt="@item.ProjectName"
                                 style="object-fit: cover; object-position: top;">
                        </div>

                        <!-- Kartın Mətn və Düymə Sahəsi -->
                        <div class="card-body d-flex flex-column p-3">

                            <!-- Project Name -->
                            <h6 class="fw-bold text-dark text-truncate mb-1" title="@item.ProjectName">
                                @item.ProjectName
                            </h6>

                            <!-- Short Description (Mətn 2 sətirdən çoxdursa avtomatik kəsilir) -->
                            <p class="text-muted small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 36px; line-height: 1.3;">
                                @item.ShortDescription
                            </p>

                            <!-- Düymələr Bloqu: Hamısı Yan-Yana tək sətirdə -->
                            <div class="d-flex gap-1 mt-auto justify-content-between align-items-center">

                                <!-- 1. GitHub -->
                                <a href="@item.GitHubURL"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-dark px-2 flex-fill"
                                   title="GitHub"
                                   style="font-size: 0.75rem; white-space: nowrap; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                    <i class="fab fa-github me-1"></i> Git
                                </a>

                                <!-- 2. Live (Əgər varsa) -->
                                @if (!string.IsNullOrWhiteSpace(item.LiveURL))
                                {
                                    <a href="@item.LiveURL"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-success px-2 flex-fill"
                                       title="Live Demo"
                                       style="font-size: 0.75rem; white-space: nowrap; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-external-link-alt me-1"></i> Live
                                    </a>
                                }

                                <!-- 3. View More (Details) -->
                                <a asp-controller="portfolio" asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-success px-2 flex-fill"
                                   style="font-size: 0.75rem; white-space: nowrap; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-weight: 500;">
                                    More..
                                </a>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

<style>
    /* Kartların daha müasir və təmiz görünməsi üçün incə toxunuşlar */
    .project-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .project-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.08) !important;
        }
</style>