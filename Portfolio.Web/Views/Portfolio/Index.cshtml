@model PortfolioVM

<style>
    /* Aside-ın eni (~270px) qədər məzmunu tamamilə sağa itələyirik */
    .portfolio-page-wrapper {
        margin-left: 290px;
        padding: 30px;
        box-sizing: border-box;
    }

    /* Kartların şəkillərinin düzgün görünməsi üçün */
    .project-card-img {
        height: 170px;
        position: relative;
        overflow: hidden;
        background-color: #f8f9fa;
    }

        .project-card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top;
        }

    /* Mobil və planşetlərdə aside gizlənirsə sol məsafəni sıfırlayırıq */
    @@media (max-width: 991px) {
        .portfolio-page-wrapper {
            margin-left: 0;
            padding: 15px;
        }
    }
</style>

<div class="portfolio-page-wrapper" id="portfolio">
    <div class="container-fluid p-0">

        <!-- Səhifə Başlığı -->
        <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
            <div class="row">
                <div class="section-title padd-15">
                    <h2>Projects</h2>
                </div>
            </div>
            <div class="portfolio-info">
            </div>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-normal shadow-sm">
                Cəmi: <strong>@Model.Projects.Count()</strong> layihə
            </span>
        </div>

        <!-- Grid: Böyük ekranda 3, orta ekranda 2 kart yan-yana -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var item in Model.Projects)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">

                        <!-- Şəkil Sahəsi + Live Badge -->
                        <div class="project-card-img">
                            <img src="~/assets/images/projects/@item.Image" alt="@item.ProjectName">

                            @if (!string.IsNullOrWhiteSpace(item.LiveURL))
                            {
                                <div class="position-absolute top-0 end-0 m-2">
                                    <span class="badge bg-dark bg-opacity-75 rounded-pill px-2 py-1 text-white extra-small fw-normal d-inline-flex align-items-center gap-1">
                                        <span class="p-1 bg-success rounded-circle"></span> Live
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- Mətn və Düymələr Sahəsi -->
                        <div class="card-body p-3 p-md-4 d-flex flex-column">
                            <h6 class="fw-bold text-dark mb-2 text-truncate" title="@item.ProjectName">
                                @item.ProjectName
                            </h6>

                            <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5rem; line-height: 1.35;">
                                @item.ShortDescription
                            </p>

                            <!-- Düymələr Bloqu -->
                            <div class="d-flex align-items-center justify-content-between gap-2 pt-3 border-top mt-auto">
                                <a asp-controller="portfolio" asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-dark rounded-pill px-3 fw-medium d-inline-flex align-items-center gap-1">
                                    <span>Ətraflı</span>
                                    <i class="fas fa-arrow-right" style="font-size: 0.7rem;"></i>
                                </a>

                                <div class="d-flex align-items-center gap-1">
                                    <a href="@item.GitHubURL"
                                       target="_blank"
                                       class="btn btn-sm btn-light rounded-circle p-0 d-inline-flex align-items-center justify-content-center text-secondary"
                                       style="width: 32px; height: 32px;"
                                       title="GitHub Repository">
                                        <i class="fab fa-github"></i>
                                    </a>

                                    @if (!string.IsNullOrWhiteSpace(item.LiveURL))
                                    {
                                        <a href="@item.LiveURL"
                                           target="_blank"
                                           class="btn btn-sm btn-light rounded-circle p-0 d-inline-flex align-items-center justify-content-center text-success"
                                           style="width: 32px; height: 32px;"
                                           title="Live Preview">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>