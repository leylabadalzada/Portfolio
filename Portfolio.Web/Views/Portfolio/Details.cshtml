@model ProjectGetVM

<section class="project-details section py-5" id="project-details">
    <div class="container py-4">
        
        <div class="row mb-4">
            <div class="col-12">
                <a asp-controller="portfolio" asp-action="Index" class="text-decoration-none text-muted small fw-medium d-inline-flex align-items-center gap-1 hover-success">
                    <i class="fas fa-arrow-left"></i> Back to Projects
                </a>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-light">
                    <div class="position-relative" style="min-height: 350px; max-height: 500px; overflow: hidden;">
                        <img src="~/assets/images/projects/@Model.Image" 
                             class="w-100 h-100 img-fluid" 
                             alt="@Model.ProjectName"
                             style="object-fit: contain; background-color: #f8f9fa;">
                    </div>
                </div>
            </div>

            <div class="col-lg-5 d-flex flex-column justify-content-between">
                <div>
                    <h1 class="fw-bold text-dark mb-2">@Model.ProjectName</h1>
                    
                    <hr class="text-muted opacity-25 mb-4">

                    <div class="project-description mb-4 text-secondary lh-lg" style="white-space: pre-line;">
                        @Model.Description
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-light">
                    <div class="row g-3 mb-4 text-muted small">
                        <div class="col-6">
                            <span class="d-block text-uppercase font-monospace text-xs">Created At</span>
                            <span class="fw-medium text-dark"><i class="far fa-calendar-alt me-1"></i> @Model.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>
                       
                    </div>

                    <div class="d-flex gap-3">
                        <a href="@Model.GitHubURL" 
                           target="_blank" 
                           class="btn btn-dark btn-lg flex-grow-1 d-inline-flex align-items-center justify-content-center gap-2 rounded-3 shadow-sm py-3"
                           style="font-size: 0.95rem; font-weight: 500;">
                            <i class="fab fa-github fs-5"></i> View Repository
                        </a>

                        @if (!string.IsNullOrWhiteSpace(Model.LiveURL))
                        {
                            <a href="@Model.LiveURL" 
                               target="_blank" 
                               class="btn btn-success btn-lg flex-grow-1 d-inline-flex align-items-center justify-content-center gap-2 rounded-3 shadow-sm py-3"
                               style="font-size: 0.95rem; font-weight: 500;">
                                <i class="fas fa-external-link-alt"></i> Live Demo
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<style>
    /* Kiçik dizayn toxunuşları */
    .hover-success {
        transition: color 0.2s ease;
    }
    .hover-success:hover {
        color: #198754 !important;
    }
    .text-xs {
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }
</style>