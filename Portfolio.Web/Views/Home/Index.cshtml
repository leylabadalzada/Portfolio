@model HomeVM

<section class="home active section" id="home">
    <div class="container">
        <div class="row">
            <div class="home-info padd-15">
                <h3 class="hello">
                    Hello, I am <span class="name">@Model.Author.FullName</span>
                </h3>
                <h3 class="my-profession">
                    <span class="typing">Backend Developer</span>
                </h3>
                <p>
                    @Model.Author.Info
                </p>
                <a href="~/assets/documents/DOC-20231229-WA0063"
                   class="btn"
                   download="">Download CV</a>
            </div>
            <div class="home-img padd-15">
                <img src="@Model.Author.ImageURL"
                     alt="My image" />
            </div>
        </div>
    </div>
</section>