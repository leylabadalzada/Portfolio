@model AboutVM

<section class="about section" id="about">
    <div class="container">
        <div class="row">
            <div class="section-title padd-15">
                <h2>About Me</h2>
            </div>
        </div>
        <div class="row">
            <div class="about-content padd-15">
                <div class="row">
                    <div class="about-text padd-15">
                        <h3>I am @Model.Author.FullName <span>Backend Developer</span></h3>
                        <p>
                            @Model.Author.Description
                        </p>
                    </div>
                </div>
                <!--Info-->
                <div class="row">
                    <div class="personal-info padd-15">
                        <div class="row">
                            <div class="info-item padd-15">
                                <i class="fa-regular fa-calendar"></i>
                                <p>Birthday: <span>@Model.Author.BirthDate.ToString("d MMM yyyy")</span></p>
                            </div>
                            <div class="info-item padd-15">
                                <i class="fa-solid fa-location-dot"></i>
                                <p>Location: <span>@Model.Author.Location</span></p>
                            </div>
                            <div class="info-item padd-15">
                                <i class="fa-regular fa-envelope"></i>
                                <p>Email: <span>lbadalzade@gmail.com</span></p>
                            </div>
                            <div class="info-item padd-15">
                                <i class="fa-brands fa-github"></i>
                                <p>
                                    GitHub:
                                    <a href="https://github.com/leylaheydarova"
                                       title="Click on">leylaheydarova</a>
                                </p>
                            </div>
                            <div class="info-item padd-15">
                                <i class="fa-brands fa-linkedin"></i>
                                <p>
                                    LinkedIn:
                                    <a href="https://www.linkedin.com/in/leyla-heydarova"
                                       title="Click on">Leyla Heydarova</a>
                                </p>
                            </div>
                            <div class="info-item padd-15">
                                <i class="fa-solid fa-laptop-file"></i>
                                <p>
                                    Freelance:
                                    <span>@(Model.Author.isFreelanceAvailable ? "Available" : "Unavailable")</span>
                                </p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="buttons padd-15">
                                <a href="#contact"
                                   data-section-index="1"
                                   class="btn hire-me">Hire Me</a>
                            </div>
                        </div>
                    </div>
                    <div class="personal-skills padd-15">
                        <div class="row">
                            <div class="info-item padd-15">
                                <p>Azerbaijani <span>- Native</span></p>
                            </div>
                            <div class="info-item padd-15">
                                <p>English <span>- C1</span></p>
                            </div>
                            <div class="info-item padd-15">
                                <p>Russian <span>- B2</span></p>
                            </div>
                            <div class="info-item padd-15">
                                <p>Turkish <span>- B2</span></p>
                            </div>
                        </div>
                    </div>
                </div>
                <!--Education & Experience-->
                <div class="row">
                    <div class="education padd-15">
                        <h3 class="title">Education</h3>
                        <div class="row">
                            <div class="timeline-box padd-15">
                                <div class="timeline shadow-dark">
                                    <!--timeline item-->
                                    <div class="timeline-item">
                                        <div class="circle-dot"></div>
                                        <h3 class="timeline-date">
                                            <i class="fa fa-calendar"></i>2024
                                        </h3>
                                        <h4 class="timeline-title">
                                            "C# based Full-Stack Developing"
                                        </h4>
                                        <p>Jet Academy programming courses.</p>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="circle-dot"></div>
                                        <h3 class="timeline-date">
                                            <i class="fa fa-calendar"></i>2021-2023
                                        </h3>
                                        <h4 class="timeline-title">
                                            "Information Technology and Systems Engineering"
                                        </h4>
                                        <p>
                                            Master degree in Azerbaijan State Oil and Industry
                                            University (with honors).
                                        </p>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="circle-dot"></div>
                                        <h3 class="timeline-date">
                                            <i class="fa fa-calendar"></i>2017-2021
                                        </h3>
                                        <h4 class="timeline-title">"Computer Science"</h4>
                                        <p>
                                            Bachelor education in Azerbaijan State Oil and
                                            Industry University.
                                        </p>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="circle-dot"></div>
                                        <h3 class="timeline-date">
                                            <i class="fa fa-calendar"></i>2013-2017
                                        </h3>
                                        <h4 class="timeline-title">
                                            "Mathematics-oriented education "
                                        </h4>
                                        <p>Ilyas Afendiyev Elitar Gymnasium.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="experience padd-15">
                        <h3 class="title">Experience</h3>
                        <div class="row">
                            <div class="timeline-box padd-15">
                                <div class="timeline shadow-dark">
                                    <!--timeline item-->
                                    <div class="timeline-item">
                                        <div class="circle-dot"></div>
                                        <h3 class="timeline-date">
                                            <i class="fa fa-calendar"></i>2024
                                        </h3>
                                        <h4 class="timeline-title">
                                            "Extensive Experience in API Development and
                                            Integration"
                                        </h4>
                                        <p>
                                            I have extensive experience in API development and
                                            integration, having designed, implemented, and
                                            maintaned numerous RESTful APIs and gRPC services.
                                            My work involves ensuring seamless communication
                                            between different system components, optimizing
                                            performance, and adhering to best practices for
                                            security and scalability. I have successfully
                                            integrated various third-party APIs and have a
                                            deep understanding of API lifecycle management,
                                            from design an development to deployment and
                                            monitoring.
                                        </p>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="circle-dot"></div>
                                        <h3 class="timeline-date">
                                            <i class="fa fa-calendar"></i>2024
                                        </h3>
                                        <h4 class="timeline-title">
                                            Expertise in MVC (Model-View-Controller) Project
                                            Implementation
                                        </h4>
                                        <p>
                                            I have substantial experience in implementing MVC
                                            (Model-View-Controller) architecture for web
                                            applications, primarily using ASP.NET. My work
                                            involves designing modular and maintable code by
                                            separating concerns across the model, view, and
                                            controller layers. This approach ensures a clear
                                            and organized codebase, enhances scalability, and
                                            simplifies debugging and testing. I have
                                            successfully delivered numerous projects
                                            leveraging MVC, focusing on clean design,
                                            efficient data handling, and seamless user
                                            interfaces
                                        </p>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="circle-dot"></div>
                                        <h3 class="timeline-date">
                                            <i class="fa fa-calendar"></i>2019-2024
                                        </h3>
                                        <h4 class="timeline-title">
                                            In-Depth Frontend Development Course
                                        </h4>
                                        <p>
                                            I have completed an in-depth frontend development
                                            course that covered the latest technologies and
                                            best practices in building dynamic and responsive
                                            web interfaces. This training provided in HTML,
                                            CSS, SCSS (SASS), JavaScript, Bootstrap, Tailwind,
                                            along with advanced React, or Vue.js. I gained
                                            hands-on experience in creating user-centric
                                            designs, optimizing performance, and ensuring
                                            cross-borwser compatibility, equipping me with the
                                            skills to develop intuitive and high-quality
                                            frontend solutions.
                                        </p>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="circle-dot"></div>
                                        <h3 class="timeline-date">
                                            <i class="fa fa-calendar"></i>2017-2024
                                        </h3>
                                        <h4 class="timeline-title">
                                            Expertise in Alorithm Analysis, Self-Search
                                            Solutions, and Logical Problem-Solving
                                        </h4>
                                        <p>
                                            My expertise includes evaluating and optimizing
                                            algorithms to ensure performance and scalability,
                                            designing custom solutions to address specific
                                            challenges, and employing a methodical
                                            problem-solving approach. This experience has
                                            enabled me to create robust, high-performance
                                            systems and contribute effectively to various
                                            development projects.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>