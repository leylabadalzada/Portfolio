@model AboutVM

<section class="about section" id="about">
    <div class="container">
        <div class="row">
            <div class="section-title padd-15">
                <h2>About Me</h2>
            </div>
        </div>
        <div class="row">
            <div class="about-content padd-15">
                <div class="row">
                    <div class="about-text padd-15">
                        <h3>I am @Model.Author.FullName <span>@Model.Speciality</span></h3>
                        <p>
                            @Model.Author.Description
                        </p>
                    </div>
                </div>
                <!--Info-->
                <div class="row">
                    <div class="personal-info padd-15">
                        <div class="row">
                            <div class="info-item padd-15">
                                <i class="fa-regular fa-calendar"></i>
                                <p>Birthday: <span>@Model.Author.BirthDate.ToString("d MMM yyyy")</span></p>
                            </div>
                            <div class="info-item padd-15">
                                <i class="fa-solid fa-location-dot"></i>
                                <p>Location: <span>@Model.Author.Location</span></p>
                            </div>
                            <div class="info-item padd-15">
                                <i class="fa-regular fa-envelope"></i>
                                <p>Email: <span>@Model.Author.Email</span></p>
                            </div>
                            @foreach(var sm in Model.SocialMedias)
                            {
                                <div class="info-item padd-15">
                                    <p>
                                        @sm.SocialMediaName:
                                        <a href="@sm.Url"
                                           title="Click on">@sm.UserName</a>
                                    </p>
                                </div>
                            }

                            <div class="info-item padd-15">
                                <i class="fa-solid fa-laptop-file"></i>
                                <p>
                                    Freelance:
                                    <span>@(Model.Author.isFreelanceAvailable ? "Available" : "Unavailable")</span>
                                </p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="buttons padd-15">
                                <a asp-controller="contact" asp-action="index"
                                   data-section-index="1"
                                   class="btn hire-me">Hire Me</a>
                            </div>
                        </div>
                    </div>
                    <div class="personal-skills padd-15">
                        <div class="row">
                            @foreach(var language in Model.Languages)
                            {
                                <div class="info-item padd-15">
                                    <p>@language.Name <span>- @language.LevelName</span></p>
                                </div>
                            }                            
                        </div>
                    </div>
                </div>
                <!--Education & Experience-->
                <div class="row">
                    <div class="education padd-15">
                        <h3 class="title">Education</h3>
                        <div class="row">
                            <div class="timeline-box padd-15">
                                <div class="timeline shadow-dark">
                                    <!--timeline item-->
                                    @foreach(var education in Model.Education)
                                    {
                                        <div class="timeline-item">
                                            <div class="circle-dot"></div>
                                            <h3 class="timeline-date">
                                                <i class="fa fa-calendar"></i>@education.StartDate?.ToString("dd MMM yyyy") -
                                                @(education.isContinuing
                                                    ? "Present"
                                                    : education.EndDate?.ToString("dd MMM yyyy"))
                                            </h3>
                                            <h4 class="timeline-title">
                                                "@education.Speciality"
                                            </h4>
                                            <h5 class="fw-bold">
                                                @education.University
                                            </h5>
                                            <p>@education.Description</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="experience padd-15">
                        <h3 class="title">Experience</h3>
                        <div class="row">
                            <div class="timeline-box padd-15">
                                <div class="timeline shadow-dark">
                                    <!--timeline item-->
                                    @foreach(var experience in Model.Experiences)
                                    {
                                        <div class="timeline-item">
                                            <div class="circle-dot"></div>
                                            <h3 class="timeline-date">
                                                <i class="fa fa-calendar"></i>@experience.StartDate?.ToString("dd MMM yyyy") -
                                                @(experience.isContinuing
                                                    ? "Present"
                                                    : experience.EndDate?.ToString("dd MMM yyyy"))
                                            </h3>
                                            <h4 class="timeline-title">
                                                @experience.Position
                                            </h4>
                                            <h5 class="fw-bold">@experience.Company</h5>
                                            <p>
                                                @experience.Description
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>