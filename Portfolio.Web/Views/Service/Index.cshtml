@model List<ServiceVM>

<section class="service section" id="service">
    <div class="container">
        <div class="row">
            <div class="section-title padd-15">
                <h2>Services</h2>
            </div>
        </div>
        <div class="tools">
            @foreach (var field in Model)
            {
                <div class="row mb-4">
                    <h3 class="tools-heading padd-15 col-12">@field.Skills.FirstOrDefault()?.FieldName</h3>

                    <div class="skills-grid px-3" style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 15px; width: 100%;">
                        @foreach (var skill in field.Skills)
                        {
                            <div class="service-item" style="width: 100%; box-sizing: border-box;">
                                <div class="service-item-inner text-center h-100" style="margin: 0 !important; width: 100% !important;">
                                    <div>
                                        <i class="@skill.Name.GetIcon() fs-1"></i>
                                    </div>
                                    <div class="service-desc">
                                        <h3>@skill.Name</h3>
                                        <p class="mb-0">@skill.Description</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>