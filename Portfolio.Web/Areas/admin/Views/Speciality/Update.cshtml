@model SpecialityUpdateVM

<div class="container my-5">
    <form asp-controller="speciality" asp-action="update" method="post">

        <div class="form-group mb-4">
            <label asp-for="Name" class="form-label mb-2">Name</label> <input asp-for="Name" class="form-control" aria-describedby="emailHelp">
        </div>

        <div class="d-flex gap-2">
            <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-action="index">Cancel</a>
            <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Update</button>
        </div>

    </form>
</div>