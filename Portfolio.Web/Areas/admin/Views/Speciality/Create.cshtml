@model SpecialityCreateVM

<div class="container my-5">
    <h3 class="mb-4 text-dark">Create Speciality Media</h3> 
    <form asp-controller="speciality" asp-action="create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group mb-3">
        <label asp-for="Name" class="form-label mb-2">Name</label>
        <input asp-for="Name" class="form-control" aria-describedby="emailHelp">
    </div>

    <div class="form-check mb-4">
        <input asp-for="IsMain" class="form-check-input" />
        <label asp-for="IsMain" class="form-check-label">Is Main</label>
    </div>

    <div class="d-flex gap-2">
        <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-action="index">Cancel</a>
        <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Create</button>
    </div>

</form>
</div>