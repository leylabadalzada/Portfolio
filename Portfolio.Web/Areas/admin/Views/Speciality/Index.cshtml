@model List<SpecialityGetVM>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark m-0">Specialities</h2>
        <a class="btn" style="background-color: #0d233a; color: white;" asp-action="create">
            <i class="fa-solid fa-plus me-1"></i> Create
        </a>
    </div>

    <div class="table-responsive mb-4">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Main</th>
                    <th scope="col">CreatedAt</th>
                    <th scope="col">UpdatedAt</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var speciality in Model)
                {
                    <tr>
                        <th scope="row">@speciality.Id</th>
                        <td>@speciality.Name</td>
                        <td>@speciality.IsMain</td>
                        <td>@speciality.CreatedAt</td>
                        <td>@speciality.UpdatedAt</td>
                        <td>
                            <div class="d-flex gap-3 justify-content-center align-items-center">

                                <form asp-action="setmain" method="post" asp-route-id="@speciality.Id" class="m-0">
                                    <button type="submit" class="btn p-0 border-0 bg-transparent">
                                        <i class="fa-solid fa-circle-check text-success fs-5"></i>
                                    </button>
                                </form>

                                <form asp-action="remove" method="post" asp-route-id="@speciality.Id" class="m-0">
                                    <button type="submit" class="btn p-0 border-0 bg-transparent">
                                        <i class="fa-solid fa-trash text-danger fs-5"></i>
                                    </button>
                                </form>

                                <a class="text-warning fs-5" asp-action="update" asp-route-id="@speciality.Id">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-area="admin" asp-controller="dashboard" asp-action="index">
        <i class="fa-solid fa-arrow-left me-1"></i> Go Dashboard
    </a>
</div>