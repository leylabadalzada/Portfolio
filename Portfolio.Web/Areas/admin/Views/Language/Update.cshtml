@model LanguageCreateOrUpdateVM

<div class="container my-5">
    <h3 class="mb-4 text-dark">Update Language</h3>

    <form asp-controller="language" asp-action="update" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label mb-2">Name</label>
            <input asp-for="Name" class="form-control" aria-describedby="emailHelp">
        </div>

        <div class="form-group mb-4">
            <label asp-for="Level" class="form-label mb-2">Language Level</label>
            <select asp-for="Level" asp-items="ViewBag.Levels" class="form-control">
                <option value="">Choose</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-action="index">Cancel</a>
            <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Update</button>
        </div>
    </form>
</div>