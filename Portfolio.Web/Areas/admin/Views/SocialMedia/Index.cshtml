@model List<SocialMediaGetVM>

<div class="container">
    <h2>Social Medias</h2>
    <a class="btn btn-success" asp-action="create">Create</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Social Media</th>
                <th scope="col">Username</th>
                <th scope="col">URL</th>
                <th scope="col">CreatedAt</th>
                <th scope="col">UpdatedAt</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var media in Model)
            {
                <tr>
                    <th scope="row">@media.Id</th>
                    <td>@media.SocialMediaName</td>
                    <td>@media.UserName</td>
                    <td>@media.Url</td>
                    <td>@media.CreatedAt</td>
                    <td>@media.UpdatedAt</td>
                    <td class="text-center"> hh
                        @* <div class="d-flex gap-3 align-items-center">
                            <form asp-action="selectresume" method="post" asp-route-id="@resume.Id" class="m-0">
                                <button type="submit" class="btn p-0 border-0 bg-transparent">
                                    <i class="fa-solid fa-circle-check text-success fs-4"></i>
                                </button>
                            </form>

                            <form asp-action="remove" method="post" asp-route-id="@resume.Id" class="m-0">
                                <button type="submit" class="btn p-0 border-0 bg-transparent">
                                    <i class="fa-solid fa-trash text-danger fs-4"></i>
                                </button>
                            </form> 
                        </div>*@
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a class="btn btn-ordinary" asp-area="admin" asp-controller="dashboard" asp-action="index">Go Dashboard</a>
</div>