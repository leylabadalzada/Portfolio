@model SocialMediaCreateOrUpdateVM

<h3>Add Social Media</h3>
<div class="container">

    <form asp-controller="socialmedia" asp-action="create" method="post">
        <div class="form-group">
            <label asp-for="SocialMediaName">Social Media</label>
            <select asp-for="SocialMediaName" asp-items="ViewBag.Names" class="form-control">
                <option value="">Choose</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="UserName">Username on Social Media</label>
            <input asp-for="UserName" class="form-control" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="Url">URL</label>
            <input asp-for="Url" class="form-control" aria-describedby="emailHelp">
        </div>
        <a class="btn" asp-action="index">Cancel</a>
        <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Add</button>
    </form>
</div>