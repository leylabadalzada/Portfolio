@model ResponseVM<List<SkillGetVM>>

<div class="container">
    <h2>Skills</h2>
    <a class="btn btn-success" asp-action="create">Create</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">Description</th>
                <th scope="col">Field</th>
                <th scope="col">CreatedAt</th>
                <th scope="col">UpdatedAt</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var skill in Model.Data)
            {
                <tr>
                    <th scope="row">@skill.Id</th>
                    <td>@skill.Name</td>
                    <td>@skill.Description</td>
                    <td>@skill.FieldName</td>
                    <td>@skill.CreatedAt</td>
                    <td>@skill.UpdatedAt</td>
                    <td class="text-center">
                        <div class="d-flex gap-3 align-items-center">
                            <a class="btn p-0 border-0 bg-transparent" asp-action="update" asp-route-id="@skill.Id">
                                <i class="fa-solid fa-edit text-warning fs-4"></i>
                            </a>

                            <form asp-action="remove" method="post" asp-route-id="@skill.Id" class="m-0">
                                <button type="submit" class="btn p-0 border-0 bg-transparent">
                                    <i class="fa-solid fa-trash text-danger fs-4"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a class="btn btn-ordinary" asp-area="admin" asp-controller="dashboard" asp-action="index">Go Dashboard</a>
</div>