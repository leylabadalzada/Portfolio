@model ResponseVM<List<SkillGetVM>>

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark m-0">Skills</h2>
        <a class="btn" style="background-color: #0d233a; color: white;" asp-action="create">
            <i class="fa-solid fa-plus me-1"></i> Create
        </a>
    </div>

    <div class="table-responsive mb-4">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Field</th>
                    <th scope="col">CreatedAt</th>
                    <th scope="col">UpdatedAt</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var skill in Model.Data)
                {
                    <tr>
                        <th scope="row">@skill.Id</th>
                        <td>@skill.Name</td>
                        <td>@skill.Description</td>
                        <td>@skill.FieldName</td>
                        <td>@skill.CreatedAt</td>
                        <td>@skill.UpdatedAt</td>
                        <td>
                            <div class="d-flex gap-3 justify-content-center align-items-center">
                                <a class="btn p-0 border-0 bg-transparent fs-5" asp-action="update" asp-route-id="@skill.Id">
                                    <i class="fa-solid fa-edit text-warning"></i>
                                </a>

                                <form asp-action="remove" method="post" asp-route-id="@skill.Id" class="m-0">
                                    <button type="submit" class="btn p-0 border-0 bg-transparent fs-5">
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-area="admin" asp-controller="dashboard" asp-action="index">
        <i class="fa-solid fa-arrow-left me-1"></i> Go Dashboard
    </a>
</div>