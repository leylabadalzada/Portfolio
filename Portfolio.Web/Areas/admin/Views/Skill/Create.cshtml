@model SkillCreateVM

<div class="container my-5">
    <h3 class="mb-4 text-dark">Create Skill</h3>

    <form asp-controller="skill" asp-action="create" method="post">

        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label mb-2">Skill</label>
            <select asp-for="Name" asp-items="ViewBag.Skills" class="form-control">
                <option value="">Choose</option>
            </select>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="form-label mb-2">Name</label>
            <input asp-for="Description" class="form-control" aria-describedby="emailHelp">
        </div>

        <div class="form-group mb-4">
            <label asp-for="FieldId" class="form-label mb-2">Field</label>
            <select asp-for="FieldId" asp-items="ViewBag.Fields" class="form-control">
                <option value="">Choose</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-action="index">Cancel</a>
            <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Create</button>
        </div>

    </form>
</div>