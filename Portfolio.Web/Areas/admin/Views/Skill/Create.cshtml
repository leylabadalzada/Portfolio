@model SkillCreateVM

<div class="container">
    <h3>Create Skill</h3>
    <form asp-controller="skill" asp-action="create" method="post">
        <div class="form-group">
            <label asp-for="Name">Skill</label>
            <select asp-for="Name" asp-items="ViewBag.Skills" class="form-control">
                <option value="">Choose</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Description">Name</label>
            <input asp-for="Description" class="form-control" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="FieldId">Field</label>
            <select asp-for="FieldId" asp-items="ViewBag.Fields" class="form-control">
                <option value="">Choose</option>
            </select>
        </div>
        <a class="btn btn-ordinary" asp-action="index">Cancel</a>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>