@model ExperienceCreateOrUpdateVM

<div class="container my-5">
    <h3 class="mb-4 text-dark">Create Experience</h3>

    <form asp-controller="Experience" asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group mb-3">
            <label asp-for="Company" class="form-label mb-2">Company</label>
            <input asp-for="Company" class="form-control" />
            <span asp-validation-for="Company" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Position" class="form-label mb-2">Position</label>
            <input asp-for="Position" class="form-control" />
            <span asp-validation-for="Position" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="form-label mb-2">Description</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label mb-2">Start Date</label>
            <div class="row g-2">
                <div class="col"><input asp-for="StartDate.Day" class="form-control" placeholder="Day" /></div>
                <div class="col"><input asp-for="StartDate.Month" class="form-control" placeholder="Month" /></div>
                <div class="col"><input asp-for="StartDate.Year" class="form-control" placeholder="Year" /></div>
            </div>
        </div>

        <div class="form-check mb-3">
            <input asp-for="isContinuing" class="form-check-input" id="isContinuing" />
            <label asp-for="isContinuing" class="form-check-label">Present</label>
        </div>

        <div class="form-group mb-4">
            <label class="form-label mb-2">End Date</label>
            <div class="row g-2">
                <div class="col"><input asp-for="EndDate.Day" class="form-control end-date-input" placeholder="Day" /></div>
                <div class="col"><input asp-for="EndDate.Month" class="form-control end-date-input" placeholder="Month" /></div>
                <div class="col"><input asp-for="EndDate.Year" class="form-control end-date-input" placeholder="Year" /></div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;">Cancel</a>
            <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Create</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const checkbox = document.getElementById("isContinuing");
            const endDateInputs = document.querySelectorAll(".end-date-input");

            function toggleEndDate() {
                endDateInputs.forEach(input => {
                    input.disabled = checkbox.checked;
                    if (checkbox.checked) {
                        input.value = "";
                    }
                });
            }

            toggleEndDate();
            checkbox.addEventListener("change", toggleEndDate);
        });
    </script>
}