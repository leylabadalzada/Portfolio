@model FieldCreateOrUpdateVM

<div class="container my-5">
    <h3 class="mb-4 text-dark">Create Field</h3>

    <form asp-controller="field" asp-action="create" method="post">
        <div class="form-group mb-4">
            <label asp-for="FieldName" class="form-label mb-2">Field</label>
            <input asp-for="FieldName" class="form-control">
        </div>

        <div class="d-flex gap-2">
            <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-action="index">Cancel</a>
            <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Create</button>
        </div>
    </form>
</div>