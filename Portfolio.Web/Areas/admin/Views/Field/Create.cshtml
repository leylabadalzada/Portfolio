@model FieldCreateOrUpdateVM
<h3>Create Field</h3>
<div class="container">
    <form asp-controller="field" asp-action="create" method="post">
        <div class="form-group">
            <label asp-for="FieldName">Field</label>
            <input asp-for="FieldName" class="form-control">
        </div>
        <a class="btn btn-ordinary" asp-action="index">Cancel</a>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>