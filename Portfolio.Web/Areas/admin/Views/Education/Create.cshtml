@model EducationCreateOrUpdateVM

<div class="container">
    <h3>Create Education</h3>

    <form asp-controller="Education" asp-action="Create" method="post">

        <div class="form-group mb-3">
            <label asp-for="University"></label>
            <input asp-for="University" class="form-control" />
            <span asp-validation-for="University" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Speciality"></label>
            <input asp-for="Speciality" class="form-control" />
            <span asp-validation-for="Speciality" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label>Start Date</label>

            <input asp-for="StartDate.Day" class="form-control mb-2" placeholder="Day" />
            <input asp-for="StartDate.Month" class="form-control mb-2" placeholder="Month" />
            <input asp-for="StartDate.Year" class="form-control" placeholder="Year" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="isContinuing" class="form-check-input" />
            <label asp-for="isContinuing" class="form-check-label">
                Present
            </label>
        </div>

        <div class="form-group mb-3">
            <label>End Date</label>

            <input asp-for="EndDate.Day"
                   class="form-control end-date-input mb-2"
                   placeholder="Day" />

            <input asp-for="EndDate.Month"
                   class="form-control end-date-input mb-2"
                   placeholder="Month" />

            <input asp-for="EndDate.Year"
                   class="form-control end-date-input"
                   placeholder="Year" />
        </div>

        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const checkbox = document.getElementById("isContinuing");
            const endDateInputs = document.querySelectorAll(".end-date-input");

            function toggleEndDate() {

                endDateInputs.forEach(input => {
                    input.disabled = checkbox.checked;

                    if (checkbox.checked) {
                        input.value = "";
                    }
                });
            }

            toggleEndDate();

            checkbox.addEventListener("change", toggleEndDate);
        });
    </script>
}