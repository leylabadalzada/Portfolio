@model ResponseVM<AuthorGetVM>

<div class="container my-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Uğurlu!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <h2 class="text-dark mb-4">Author Details</h2>

    <div class="table-responsive mb-4">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">FirstName</th>
                    <th scope="col">LastName</th>
                    <th scope="col">Email</th>
                    <th scope="col">Info</th>
                    <th scope="col">Description</th>
                    <th scope="col">Location</th>
                    <th scope="col">Birthdate</th>
                    <th scope="col">Phone</th>
                    <th scope="col">IsFreeAvailable</th>
                    <th scope="col">Image</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">@Model.Data.Id</th>
                    <td>@Model.Data.FirstName</td>
                    <td>@Model.Data.LastName</td>
                    <td>@Model.Data.Email</td>
                    <td>@Model.Data.Info</td>
                    <td>@Model.Data.Description</td>
                    <td>@Model.Data.Location</td>
                    <td>@Model.Data.BirthDate</td>
                    <td>@Model.Data.PhoneNumber</td>
                    <td>@(Model.Data.isFreelanceAvailable == true ? "Yes" : "No")</td>
                    <td>
                        <img src="~/assets/images/authors/@Model.Data.ImageName"
                             class="rounded border"
                             width="60"
                             height="60"
                             style="object-fit: cover;"
                             alt="Author Image" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex gap-2">
        <a class="btn" style="background-color: #0d233a; color: white;" asp-area="admin" asp-controller="author" asp-action="update">
            <i class="fa-solid fa-pen-to-square me-1"></i> Update
        </a>
        <a class="btn" style="background-color: #0d233a; color: white;" asp-area="admin" asp-controller="author" asp-action="changeimage">
            <i class="fa-solid fa-image me-1"></i> Change Image
        </a>
        <a class="btn" style="background-color: #0d233a; color: white;" asp-area="admin" asp-controller="author" asp-action="changeemail">
            <i class="fa-solid fa-image me-1"></i> Change Email
        </a>
        <a class="btn" style="background-color: #0d233a; color: white;" asp-area="admin" asp-controller="author" asp-action="checkpassword">
            <i class="fa-solid fa-image me-1"></i> Change Password
        </a>
        <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-area="admin" asp-controller="dashboard" asp-action="index">
            <i class="fa-solid fa-arrow-left me-1"></i> Go Dashboard
        </a>
    </div>
</div>