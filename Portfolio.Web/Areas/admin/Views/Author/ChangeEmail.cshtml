@model string

<div class="container my-5">
    <h3 class="mb-4 text-dark">Change Email</h3>

    <form asp-controller="author" asp-action="ChangeEmail" method="post" >
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group mb-4">
            <label for="email" class="form-label mb-2">New Email</label>
            <input type="email" name="email" id="email" class="form-control" value="@Model">
        </div>

        <div class="d-flex gap-2">
            <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-action="index">Cancel</a>
            <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Change</button>
        </div>
    </form>
</div>