@model ChangePasswordVM

<div class="container my-5">
    <h3 class="mb-4 text-dark">Change Password</h3>

    <form asp-controller="author" asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group mb-4">
            <label asp-for="NewPassword" class="form-label mb-2">New Password</label>
            <input asp-for="NewPassword" type ="password" class="form-control">
        </div>

        <div class="form-group mb-4">
            <label asp-for="ConfirmNewPassword" class="form-label mb-2">New Password</label>
            <input asp-for="ConfirmNewPassword" type="password" class="form-control">
        </div>

        <div class="d-flex gap-2">
            <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-action="checkpassword">Back</a>
            <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Change</button>
        </div>
    </form>
</div>

