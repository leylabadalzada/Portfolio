@model ChangeImageDto

<form asp-controller="author" asp-action="ChangeImage" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="NewImage">Image</label>
        <input asp-for="NewImage" type="file" class="form-control" aria-describedby="emailHelp">
        @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
    </div>
    <button type="submit" class="btn btn-primary">Change</button>
</form>