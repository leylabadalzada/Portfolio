@model AuthorUpdateVM
<div class="container">
    
    <form asp-controller="author" asp-action="edit" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label asp-for="FirstName">FirstName</label>
            <input asp-for="FirstName" class="form-control" aria-describedby="emailHelp" placeholder="E.G John">
            @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
        </div>
        <div class="form-group">
            <label asp-for="LastName">LastName</label>
            <input asp-for="LastName" class="form-control" aria-describedby="emailHelp" placeholder="E.G Doe">
            @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
        </div>
        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" class="form-control" aria-describedby="emailHelp" placeholder="E.G samle@example.com">
            @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
        </div>
        <div class="form-group">
            <label asp-for="Description">Description</label>
            <input asp-for="Description" class="form-control" aria-describedby="emailHelp" placeholder="About page">
            @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
        </div>
        <div class="form-group">
            <label asp-for="Info">Info</label>
            <input asp-for="Info" class="form-control" aria-describedby="emailHelp" placeholder="Home page">
            @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
        </div>
        <div class="form-group">
            <label asp-for="Location">Location</label>
            <input asp-for="Location" class="form-control" aria-describedby="emailHelp" placeholder="Country and City">
            @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
        </div>
        <div class="form-group">
            <label asp-for="BirthDate.Day">Day</label>
            <input asp-for="BirthDate.Day" class="form-control" aria-describedby="emailHelp">
            @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
        </div>
        <div class="form-group">
            <label asp-for="BirthDate.Month">Month</label>
            <input asp-for="BirthDate.Month" class="form-control" aria-describedby="emailHelp">
            @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
        </div>
        <div class="form-group">
            <label asp-for="BirthDate.Year">Year</label>
            <input asp-for="BirthDate.Year" class="form-control" aria-describedby="emailHelp">
            @* <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small> *@
        </div>
        <div class="form-check">
            <label asp-for="isFreelanceAvailable">Is Freelance Available?</label>
            <select asp-for="isFreelanceAvailable" class="form-select">
                <option value="">Not Chosen</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>
        <a class="btn btn-ordinary" asp-action="index">Cancel</a>
        <button type="submit" class="btn btn-primary">Update</button>
    </form>
</div>