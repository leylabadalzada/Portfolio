@model VerifyEmailVM

<div class="container my-5">
    <h3 class="mb-4 text-dark">Change Author Image</h3>

    <form asp-controller="author" asp-action="VerifyEmail" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group mb-4">
            <label asp-for="OtpCode" class="form-label mb-2">Otp Code</label>
            <input asp-for="OtpCode" class="form-control">
        </div>

        <div class="d-flex gap-2">
            <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-action="index">Cancel</a>
            <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Verify</button>
        </div>
    </form>
</div>