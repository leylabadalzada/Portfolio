@model ProjectUpdateVM
<h3>Upload Resume</h3>
<div class="container">
    <img alt="Image"
         class="rounded-circle border"
         width="50"
         height="50"
         style="object-fit: cover;" src="~/assets/images/projects/@Model.ImageName" />
    <form asp-controller="project" asp-action="update" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Image">Image</label>
            <input asp-for="Image" type="file" class="form-control" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="ProjectName">Name</label>
            <input asp-for="ProjectName" class="form-control" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="ShortDescription">Short Description</label>
            <input asp-for="ShortDescription" class="form-control" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="Description">Description</label>
            <input asp-for="Description" class="form-control" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="GitHubURL">GitHub</label>
            <input asp-for="GitHubURL" class="form-control" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="LiveURL">Live</label>
            <input asp-for="LiveURL" class="form-control" aria-describedby="emailHelp">
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsFeatured" class="form-check-input" />
            <label asp-for="IsFeatured" class="form-check-label">
                Featured
            </label>
        </div>
        <a class="btn" asp-action="index">Cancel</a>
        <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Update</button>
    </form>
</div>