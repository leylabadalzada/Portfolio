@model ProjectCreateVM

<div class="container my-5">
    <h3 class="mb-4 text-dark">Create Project</h3>

    <form asp-controller="project" asp-action="create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group mb-3">
            <label asp-for="Image" class="form-label mb-2">Image</label>
            <input asp-for="Image" type="file" class="form-control">
        </div>

        <div class="form-group mb-3">
            <label asp-for="ProjectName" class="form-label mb-2">Name</label>
            <input asp-for="ProjectName" class="form-control">
        </div>

        <div class="form-group mb-3">
            <label asp-for="ShortDescription" class="form-label mb-2">Short Description</label>
            <textarea asp-for="ShortDescription" class="form-control"></textarea>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="form-label mb-2">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="form-group mb-3">
            <label asp-for="GitHubURL" class="form-label mb-2">GitHub</label>
            <input asp-for="GitHubURL" class="form-control">
        </div>

        <div class="form-group mb-4">
            <label asp-for="LiveURL" class="form-label mb-2">Live</label>
            <input asp-for="LiveURL" class="form-control">
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsFeatured" class="form-check-input" />
            <label asp-for="IsFeatured" class="form-check-label">Featured</label>
        </div>

        <div class="d-flex gap-2">
            <a class="btn" style="background-color: transparent; color: #0d233a; border: 1px solid #0d233a;" asp-action="index">Cancel</a>
            <button type="submit" class="btn" style="background-color: #0d233a; color: white;">Create</button>
        </div>
    </form>
</div>